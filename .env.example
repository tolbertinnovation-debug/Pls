# Canonical origin used for metadata, sitemap.xml and robots.txt.
# Set this to the real domain before going live.
NEXT_PUBLIC_SITE_URL=https://peaklogisticsservices.com

# --- Quote form email delivery (optional) ---
# Until RESEND_API_KEY is set, /api/quote validates submissions and reports
# "not configured"; the form then offers the visitor a prefilled email and the
# office phone number instead of pretending the request was sent.
# RESEND_API_KEY=
# QUOTE_TO_EMAIL=peaklogisticsservices@gmail.com
# QUOTE_FROM_EMAIL=quotes@yourdomain.com
