# Canonical site URL, including any subpath it is served from.
# This single value drives the base path, canonical URLs, Open Graph tags,
# sitemap.xml and robots.txt — next.config.ts derives basePath from its path.
#
#   GitHub Pages   https://tolbertinnovation-debug.github.io/Pls   (base path /Pls)
#   Custom domain  https://peaklogisticsservices.com               (no base path)
#
# It is set for deployments in .github/workflows/deploy.yml. Locally you can
# drop the subpath so the dev server runs at http://localhost:3000/
NEXT_PUBLIC_SITE_URL=https://tolbertinnovation-debug.github.io/Pls

# Optional override for where the quote form posts.
#
# By default submissions go to FormSubmit, which emails them to the address in
# src/lib/site.ts (peaklogisticsservices@gmail.com). That needs no account or
# API key, but the FIRST submission sends a one-time confirmation email to that
# inbox — until someone clicks the link in it, nothing is delivered.
#
# Set this to use a different relay (Formspree, Web3Forms, a Google Apps
# Script) or a real server route later. Any URL accepting a JSON POST works.
# It can also be set as a repository variable of the same name.
# NEXT_PUBLIC_QUOTE_ENDPOINT=https://formspree.io/f/xxxxxxx
